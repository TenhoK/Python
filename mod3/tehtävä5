leiviskät = int(input("Anna leiviskät: "))
naulat = int(input("Anna naulat: "))
luodit = float(input("Anna luodit: "))

kaikkiNauluat = leiviskät * 20 + naulat
kaikkiLuodit = kaikkiNauluat * 32 + luodit
grammat = kaikkiLuodit * 13.3
kg = 0

kg = int(grammat / 1000)
grammat = grammat % 1000

print("Massa nykymittojen mukaan:", kg, "kg", grammat, "g")