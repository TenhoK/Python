            pelaaja.LisääReppuun(pelaaja.sijainti.esine)
            pelaaja.sijainti.esine = None
    
    print("")
    print("Mihin mennään seuraavaksi?")
    for paikka in pelaaja.sijainti.seuraavatPaikat:
        print("-", paikka.nimi)
    
    seuraavaPaikka = input("Valitse Vaihtoehto: ")
    for paikka in pelaaja.sijainti.seuraavatPaikat:
        if seuraavaPaikka == paikka.nimi:
            if paikka.vaatii != None and paikka.vaatii not in pelaaja.esineet:
                print(f"Et pääse paikkaan {paikka.nimi}, koska sinulta puuttuu: {paikka.vaatii.nimi}")
                print("HÄVISIT PELIN! Et päässy ajoissa kouluun")
                return True
            else:
                print(f"Valitsit: {paikka.nimi}")
                pelaaja.Liiku(paikka)

                if pelaaja.energia < 0:
                    print("HÄVISIT PELIN! Energia loppui ennen kuin pääsit kouluun")
                    return True
    
    return False


