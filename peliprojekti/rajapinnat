import json
import urllib.request
import urllib.parse
import urllib.error


def hae_json(url, params=None):
    """Hakee osoitteesta JSON-datan ja palauttaa sen Python-sanakirjana."""
    if params:
        url = url + "?" + urllib.parse.urlencode(params)
    pyynto = urllib.request.Request(url, headers={"User-Agent": "python-harjoitus"})
    with urllib.request.urlopen(pyynto, timeout=10) as vastaus:
        return json.loads(vastaus.read().decode("utf-8"))


