lämpötila = float(input("Anna Lämpötila: "))
if lämpötila < 0:
    print ("Lämpötila on pakkasen puolella")
else:
    print("Lämpötila ei ole pakkasen puolella")

opintoPisteet = int(input("Anna opintopisteiden määrä: "))
if opintoPisteet >= 180:
    print ("Opiskelijalla on vähintään 180 opintopistettä")
else:
    print ("Opiskelijalla on vähemmän 180 opintopistettä")

