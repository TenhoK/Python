lista = [1,2,3,4,5,6,7,8,9]

def KarsiParittomat(karsittavaLista):
    karsittuLista = []
    for numero in karsittavaLista:
        if numero % 2 == 0:
            karsittuLista.append(numero)
    return karsittuLista

lista = KarsiParittomat(lista)
print(lista)

